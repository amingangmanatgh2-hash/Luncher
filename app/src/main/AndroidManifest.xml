<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions are kept to the strict minimum.

      INTERNET               : required only to talk to the Gemini API (or your proxy).
      ACCESS_NETWORK_STATE   : lets the AI screens show a proper offline state instead of timing out.
      PACKAGE_USAGE_STATS    : OPTIONAL. Only used for the "Recently used" row when the user explicitly
                               grants it in system settings. The launcher works fully without it and
                               falls back to its own on-device launch history.
      SET_WALLPAPER          : allows the wallpaper picker shortcut from the home-screen long-press menu.
      BIND_APPWIDGET         : NOT requested. Widgets are bound through the system consent dialog
                               (ACTION_APPWIDGET_BIND) instead, which is the privilege-free path.
      Notification access    : granted by the user in system settings, never requested at runtime.
                               Only per-package counts are read; no content is stored or sent.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
      Package visibility (Android 11+). A launcher legitimately needs to see the
      activities it is supposed to launch. Declaring the intent filter here is the
      privacy-preserving alternative to QUERY_ALL_PACKAGES.
    -->
    <!--
      Icon packs advertise themselves with these legacy theme intents. Declaring them lets the
      settings screen list the packs the user already has installed, without QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="ch.deletescape.lawnchair.ICONPACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!--
          Lets the chat screen detect whether a system speech recogniser exists before showing the
          microphone button. Dictation is delegated to that app, so DLCK LNCH itself never needs
          the RECORD_AUDIO permission and never touches the microphone.
        -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.DlckLnch">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.DlckLnch"
            android:windowSoftInputMode="adjustResize">

            <!-- Normal app entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- This is what makes DLCK LNCH selectable as the Android home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Assist gesture opens the AI assistant -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="true" />
        </activity>

        <!--
          Optional notification listener used only for the unread dots on icons.
          The user must enable it manually in Settings → Notifications → Device & app notifications;
          the launcher cannot grant it to itself. Only per-package counts are kept in memory.
        -->
        <service
            android:name=".notifications.DlckNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
