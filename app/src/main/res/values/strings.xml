    <string name="setup_saved">Credential saved to the encrypted store.</string>
    <string name="setup_security">Security information</string>
    <string name="setup_security_body">• The key is stored with Android EncryptedSharedPreferences (AES-256-GCM, hardware-backed keystore).\n• It is never written to the source code, the APK, logs, or Git.\n• It is excluded from cloud backup and device transfer.\n• It is sent only over HTTPS to the endpoint shown above.\n• Uninstalling DLCK LNCH destroys the stored key.</string>
    <string name="setup_usage">Usage information</string>
    <string name="setup_usage_body">Every message you send uses your own Gemini quota. Free-tier keys are rate limited per minute and per day. Check quota and spending in Google AI Studio → “Get API key” → “Usage”, or in Google Cloud Console if your key is attached to a billed project.</string>
    <string name="setup_open_ai_studio">Open Google AI Studio</string>
    <string name="setup_open_docs">Open Gemini API docs</string>
    <string name="setup_open_usage">Open usage &amp; billing</string>
    <string name="setup_tutorial">Tutorial</string>
    <string name="setup_tutorial_step1">1. Open Google AI Studio and sign in with your Google account.</string>
    <string name="setup_tutorial_step2">2. Tap “Get API key” → “Create API key” and copy it.</string>
    <string name="setup_tutorial_step3">3. Come back here, paste it into the field above and tap “Save credential”.</string>
    <string name="setup_tutorial_step4">4. Tap “Test connection”. A green “Connected” badge means everything works.</string>
    <string name="setup_tutorial_step5">5. Open the AI Assistant and try “Open Wi-Fi settings”.</string>
    <string name="setup_tutorial_step6">6. To rotate a key: delete it here, create a new one in AI Studio, then save it again.</string>
    <string name="setup_empty_key_error">Please paste a key first.</string>
    <string name="setup_key_format_warning">That does not look like a Google API key (they usually start with “AIza”). Saving anyway.</string>

    <!-- Gemini errors -->
    <string name="err_no_key">No API key configured. Add one in AI Setup.</string>
