    <path android:fillColor="#FF60A5FA" android:pathData="M54,83 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    <path android:fillColor="#FFA78BFA" android:pathData="M70,83 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
