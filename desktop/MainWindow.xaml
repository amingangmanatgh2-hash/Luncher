<Window x:Class="Luncher.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource K_Title}"
        Height="640" Width="960" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17" Foreground="#E6EDF3" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Act" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1B2431"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#2A3646"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Act}">
            <Setter Property="Background" Value="#F0B429"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="BorderBrush" Value="#F0B429"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B98A9"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Luncher" FontSize="24" FontWeight="Bold" Foreground="#F0B429"/>
                <TextBlock Text="{DynamicResource K_Subtitle}" Foreground="#8B98A9" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateModeBtn" Style="{StaticResource Act}" Click="OnCycleUpdateMode"
                        ToolTip="{DynamicResource K_UpdateTrust}"/>
                <Button x:Name="UpdateBtn" Style="{StaticResource Act}" Content="{DynamicResource K_Update}" Click="OnCheckUpdate"/>
                <Button x:Name="LangBtn" Style="{StaticResource Act}" Content="{DynamicResource K_Lang}" Click="OnLang"/>
                <Button x:Name="NetBtn" Style="{StaticResource Accent}" Content="{DynamicResource K_NetCheck}" Click="OnNetCheck"/>
            </StackPanel>
        </Grid>

        <!-- toolbar -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="AddLinkBtn"  Style="{StaticResource Act}" Content="{DynamicResource K_AddLink}" Click="OnAddLink"/>
            <Button x:Name="AddSubBtn"   Style="{StaticResource Act}" Content="{DynamicResource K_AddSub}" Click="OnAddSub"/>
            <Button x:Name="RefreshBtn"  Style="{StaticResource Act}" Content="{DynamicResource K_Refresh}" Click="OnRefresh"/>
            <Button x:Name="CopyAllBtn"  Style="{StaticResource Act}" Content="{DynamicResource K_CopyAll}" Click="OnCopyAll"/>
            <Button x:Name="ExportBtn"   Style="{StaticResource Act}" Content="{DynamicResource K_Export}" Click="OnExport"/>
            <Button x:Name="OpenBtn"     Style="{StaticResource Act}" Content="{DynamicResource K_OpenClient}" Click="OnOpenClient"/>
        </WrapPanel>

        <!-- body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="{DynamicResource K_Subs}"/>
                <ListBox x:Name="SubList" Grid.Row="1" Background="#111827" BorderThickness="0"
                         Foreground="#E6EDF3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,7">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8B98A9" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#5C6B7F" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource K_Refresh}" Click="OnRefreshSub"/>
                            <MenuItem Header="{DynamicResource K_Copy}" Click="OnCopySubUrl"/>
                            <MenuItem Header="{DynamicResource K_Delete}" Click="OnDeleteSub"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ConfigsHeading" Grid.Row="0" Style="{StaticResource Heading}" Text="{DynamicResource K_Configs}"/>
                <ListBox x:Name="ConfigList" Grid.Row="1" Background="#111827" BorderThickness="0"
                         Foreground="#E6EDF3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,7">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#F0B429"/>
                                <TextBlock Text="{Binding Link}" FontSize="10" Foreground="#5C6B7F" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource K_Copy}" Click="OnCopyConfig"/>
                            <MenuItem Header="{DynamicResource K_Open}" Click="OnOpenConfig"/>
                            <MenuItem Header="{DynamicResource K_Delete}" Click="OnDeleteConfig"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{DynamicResource K_Empty}" FontSize="17" FontWeight="SemiBold"
                               Foreground="#8B98A9" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource K_EmptyHint}" Foreground="#5C6B7F"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- status -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,8" Background="#111827" CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="{DynamicResource K_StatusReady}" Foreground="#8B98A9" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource K_NotATunnel}" FontSize="11" Foreground="#5C6B7F"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
