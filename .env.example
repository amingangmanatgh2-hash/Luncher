# -----------------------------------------------------------------------------
# DLCK LNCH — example environment file.
#
# This file is a TEMPLATE only. Copy it to `.env` and put your real value there.
# `.env` is git-ignored and is NEVER read by the Android app or baked into the APK.
#
#   cp .env.example .env
#
# It is used ONLY by the local developer helper script:
#   ./scripts/verify_gemini.sh
#
# The DLCK LNCH app itself asks for the key at runtime (Settings -> AI Setup) and
# stores it in Android EncryptedSharedPreferences on the device.
# -----------------------------------------------------------------------------

GEMINI_API_KEY=

# Optional: override the API host when you run your own secure proxy
# (see proxy/ for a reference implementation).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: default model used by the verify script.
# GEMINI_MODEL=gemini-2.5-flash
